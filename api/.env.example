APP_NAME="Voice Note CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8473

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses SQLite (database/database.sqlite).
DB_CONNECTION=sqlite

# Production uses PostgreSQL:
# DB_CONNECTION=pgsql
# DB_HOST=your-db-host
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=your-db-user
# DB_PASSWORD=your-db-password
# The schema to use, and "require" for hosted databases. Run `php artisan db:enable-rls` after migrating.
# DB_SEARCH_PATH=voice_note_crm
# DB_SSLMODE=require

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Origin(s) of the web app, comma-separated. Used for CORS.
FRONTEND_URL=http://localhost:5473
SANCTUM_EXPIRATION=10080

# "Try the demo" sign-in to the shared demo organization (seed it with `php artisan db:seed`).
DEMO_LOGIN_ENABLED=true

# Where encrypted voice note audio is stored: "local" (storage/app/private/audio) or "s3".
# Uploads need PHP's upload_max_filesize and post_max_size above 25M (e.g. 26M / 27M).
AUDIO_DISK=local
# For AUDIO_DISK=s3 with Supabase Storage's S3 endpoint (Project Settings > Storage > S3 access keys):
# AWS_ACCESS_KEY_ID=your-s3-access-key-id
# AWS_SECRET_ACCESS_KEY=your-s3-secret-access-key
# AWS_DEFAULT_REGION=your-project-region
# AWS_BUCKET=your-private-bucket
# AWS_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
# AWS_USE_PATH_STYLE_ENDPOINT=true
