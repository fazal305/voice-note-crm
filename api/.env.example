APP_NAME="Voice Note CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8473

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses SQLite (database/database.sqlite).
DB_CONNECTION=sqlite

# Production uses PostgreSQL:
# DB_CONNECTION=pgsql
# DB_HOST=your-db-host
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=your-db-user
# DB_PASSWORD=your-db-password
# The schema to use, and "require" for hosted databases. Run `php artisan db:enable-rls` after migrating.
# DB_SEARCH_PATH=voice_note_crm
# DB_SSLMODE=require

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Origin(s) of the web app, comma-separated. Used for CORS.
FRONTEND_URL=http://localhost:5473
SANCTUM_EXPIRATION=10080

# "Try the demo" sign-in to the shared demo organization (seed it with `php artisan db:seed`).
DEMO_LOGIN_ENABLED=true
# Optional: a public password for the demo accounts so they can also use the login form. Unset = random, unusable passwords.
DEMO_PASSWORD=

# Where encrypted voice note audio is stored: "local" (storage/app/private/audio) or "s3".
# Uploads need PHP's upload_max_filesize and post_max_size above 25M (e.g. 26M / 27M).
AUDIO_DISK=local
# For AUDIO_DISK=s3 with Supabase Storage's S3 endpoint (Project Settings > Storage > S3 access keys):
# AWS_ACCESS_KEY_ID=your-s3-access-key-id
# AWS_SECRET_ACCESS_KEY=your-s3-secret-access-key
# AWS_DEFAULT_REGION=your-project-region
# AWS_BUCKET=your-private-bucket
# AWS_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
# AWS_USE_PATH_STYLE_ENDPOINT=true

# Background processing. Uploads are transcribed and parsed by queued jobs: run a worker alongside the API
# (`php artisan queue:work`, e.g. as a separate background-worker service in production).

# Speech to text: any OpenAI-compatible /audio/transcriptions endpoint (default: Groq's Whisper).
# Leave STT_API_KEY empty to skip transcription: notes then wait for the rep to type or paste the transcript.
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo

# Transcript parsing: any OpenAI-compatible chat completions endpoint (default: OpenRouter).
# Leave LLM_API_KEY empty to parse with basic rules only; rules are also used whenever the model fails.
# Free models change often; check https://openrouter.ai/api/v1/models for a current ":free" id.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemma-4-31b-it:free

# Protects POST /api/cron/run, which deletes demo-organization notes older than 24 hours. Hosts with cron can run
# `php artisan schedule:run` every minute instead; hosts without it use the "Demo cleanup" GitHub Action, which
# needs this value as the CRON_SECRET repository secret and the API's origin as the API_URL repository variable.
# Generate one with: php -r "echo bin2hex(random_bytes(32));"
CRON_SECRET=
